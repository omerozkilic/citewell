# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- database ---------------------------------------------------------------
CITEWELL_DATABASE_URL=postgresql://citewell:citewell@localhost:5432/citewell

# --- embeddings (fixed per database: changing them requires a fresh DB) -----
CITEWELL_EMBEDDING_BACKEND=sentence-transformers
CITEWELL_EMBEDDING_MODEL=BAAI/bge-m3
CITEWELL_EMBEDDING_DIM=1024
# Alternative: CITEWELL_EMBEDDING_MODEL=intfloat/multilingual-e5-large (1024-d)
#              CITEWELL_EMBEDDING_MODEL=intfloat/multilingual-e5-base  (768-d)
# CITEWELL_EMBEDDING_DEVICE=cpu        # cpu | cuda | mps (default: auto)

# --- reranker ---------------------------------------------------------------
CITEWELL_RERANKER_BACKEND=sentence-transformers
CITEWELL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CITEWELL_RERANK_BY_DEFAULT=false

# --- chunking & search --------------------------------------------------------
CITEWELL_CHUNK_SIZE=1000
CITEWELL_CHUNK_OVERLAP=150
CITEWELL_DEFAULT_LANGUAGE=turkish
CITEWELL_DEFAULT_MODE=hybrid
CITEWELL_DEFAULT_TOP_K=5

# --- servers ------------------------------------------------------------------
CITEWELL_HOST=127.0.0.1
CITEWELL_PORT=8000
# CITEWELL_API_TOKEN=change-me         # require "Authorization: Bearer <token>"

# Fully offline after `citewell models download`:
# HF_HUB_OFFLINE=1
